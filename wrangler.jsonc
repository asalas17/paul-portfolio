{
  "name": "paul-portfolio",
  "compatibility_date": "2026-10-21",
  "routes": [
    { "pattern": "paulc.dev", "custom_domain": true },
    { "pattern": "www.paulc.dev", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
