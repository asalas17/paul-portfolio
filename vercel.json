{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "paulcohen.vercel.app" }],
      "destination": "https://paulc.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "paulcohen.vercel.app" }],
      "destination": "https://paulc.dev/:path*",
      "permanent": true
    }
  ]
}
